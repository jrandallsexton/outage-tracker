{
  "platform": {
    "apiRuntime": "dotnet-isolated:10.0"
  },
  "routes": [
    { "route": "/api/manage/*", "allowedRoles": ["admin"] },
    { "route": "/sw.js", "headers": { "cache-control": "no-cache" } },
    { "route": "/assets/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/.auth/*", "/assets/*", "/admin.html", "*.{png,svg,ico,json,webmanifest,js,css}"]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data: https://*.blob.core.windows.net; connect-src 'self' https://*.blob.core.windows.net; frame-ancestors 'none'; base-uri 'self'"
  }
}
